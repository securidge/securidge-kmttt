{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KMttt Desktop",
  "version": "1.2.1",
  "identifier": "com.securidge.kmttt.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KMttt Desktop — Securidge Trusted Terminal Tracker",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "app"
    ],
    "publisher": "Kwangmo Kim (personal project)",
    "copyright": "Kwangmo Kim. MIT OR Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Window app for Securidge KMttt (non-commercial personal project)",
    "longDescription": "KMttt Desktop shows KMttt workspaces, terminals, AI agents, approvals, usage limits and settings in one window, with step-by-step guidance. A non-commercial personal project by Kwangmo Kim.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "licenseFile": "windows/NOTICE.rtf"
  }
}
